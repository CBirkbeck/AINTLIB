import «Adic spaces».FJP.TatePointEval

/-!
# The Taylor comparison for Tate algebras at rational points

([hrw-decomposition] Tate leaf 13b.) The zero-point coefficient
decomposition `F = C(F(0)) + Σᵢ Xᵢ·Gᵢ` (least-nonzero-coordinate slicing —
purely combinatorial, no analysis), whence the point ideal at the origin is
generated by the variables. Downstream: translation automorphisms, the
levelwise identification `P/𝔫₀ʳ ≅ L[X]/(X)ʳ`, and the embedding of the
completed local ring into `L⟦X⟧`.
-/

@[expose] public section

open scoped Classical

open Filter ValuationSpectrum

namespace FiniteJet.GraphKoszul

variable {L : Type*} [NormedField L] [IsUltrametricDist L] [CompleteSpace L]
variable {m : ℕ}

/-- The `i`-th origin slice of a restricted series: coefficients re-indexed
along `d ↦ d + eᵢ`, supported where all earlier coordinates vanish. -/
noncomputable def originSlice (i : Fin m) (F : P L m) : P L m :=
  ⟨fun d => if ∀ j < i, d j = 0 then
      MvPowerSeries.coeff (d + Finsupp.single i 1) F.1 else 0, by
    show Filter.Tendsto (fun d : Fin m →₀ ℕ =>
      ‖(fun e : Fin m →₀ ℕ => if ∀ j < i, e j = 0 then
        MvPowerSeries.coeff (e + Finsupp.single i 1) F.1 else 0) d‖ *
        d.prod fun j k => (fun _ : Fin m => (1 : ℝ)) j ^ k)
      cofinite (nhds 0)
    have hF : Filter.Tendsto (fun t : Fin m →₀ ℕ =>
        ‖MvPowerSeries.coeff t F.1‖ *
          t.prod fun j k => (fun _ : Fin m => (1 : ℝ)) j ^ k)
        cofinite (nhds 0) := F.2
    simp only [weight_one, mul_one] at hF ⊢
    have hinj : Function.Injective
        (fun d : Fin m →₀ ℕ => d + Finsupp.single i 1) :=
      fun a b hab => by simpa using hab
    have hcomp : Filter.Tendsto (fun d : Fin m →₀ ℕ =>
        ‖MvPowerSeries.coeff (d + Finsupp.single i 1) F.1‖)
        cofinite (nhds 0) :=
      hF.comp hinj.tendsto_cofinite
    refine squeeze_zero (fun d => norm_nonneg _) (fun d => ?_) hcomp
    by_cases hd : ∀ j < i, d j = 0
    · rw [if_pos hd]
    · rw [if_neg hd, norm_zero]
      exact norm_nonneg _⟩

theorem originSlice_coeff (i : Fin m) (F : P L m) (d : Fin m →₀ ℕ) :
    MvPowerSeries.coeff d ((originSlice (m := m) i F).1) =
      if ∀ j < i, d j = 0 then
        MvPowerSeries.coeff (d + Finsupp.single i 1) F.1 else 0 := rfl

/-- **The zero-point coefficient decomposition**: every restricted series is
its constant term plus `Σᵢ Xᵢ·(slice)ᵢ`, splitting each nonzero multi-index
at its least nonzero coordinate. -/
theorem origin_decomposition (F : P L m) :
    F = polyToP (MvPolynomial.C (MvPowerSeries.coeff 0 F.1)) +
      ∑ i, polyToP (MvPolynomial.X i) * originSlice i F := by
  refine Subtype.ext (MvPowerSeries.ext fun t => ?_)
  have hsum : ((polyToP (MvPolynomial.C (MvPowerSeries.coeff 0 F.1)) +
      ∑ i, polyToP (MvPolynomial.X i) * originSlice i F : P L m)).1 =
      (MvPowerSeries.C (MvPowerSeries.coeff 0 F.1) :
        MvPowerSeries (Fin m) L) +
      ∑ i, (MvPowerSeries.X i : MvPowerSeries (Fin m) L) *
        (originSlice i F).1 := by
    have h1 : ((polyToP (MvPolynomial.C (MvPowerSeries.coeff 0 F.1)) +
        ∑ i, polyToP (MvPolynomial.X i) * originSlice i F : P L m)).1 =
        seriesP (polyToP (MvPolynomial.C (MvPowerSeries.coeff 0 F.1)) +
          ∑ i, polyToP (MvPolynomial.X i) * originSlice i F) := rfl
    rw [h1, map_add, map_sum]
    congr 1
    · exact MvPolynomial.coe_C _
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul]
      congr 1
      exact MvPolynomial.coe_X i
  rw [hsum, map_add, map_sum]
  rcases eq_or_ne t 0 with rfl | ht
  · -- constant term: the X-terms vanish
    rw [MvPowerSeries.coeff_C, if_pos rfl]
    rw [Finset.sum_eq_zero fun i _ => MvPowerSeries.coeff_zero_X_mul _ i]
    rw [add_zero]
  · -- t ≠ 0: exactly the least nonzero coordinate contributes
    rw [MvPowerSeries.coeff_C, if_neg ht, zero_add]
    have hne : t.support.Nonempty := Finsupp.support_nonempty_iff.mpr ht
    set i₀ := t.support.min' hne with hi₀
    have hi₀mem : i₀ ∈ t.support := t.support.min'_mem hne
    have hti₀ : t i₀ ≠ 0 := Finsupp.mem_support_iff.mp hi₀mem
    have hmin : ∀ j < i₀, t j = 0 := fun j hj => by
      by_contra hj0
      exact absurd (t.support.min'_le j (Finsupp.mem_support_iff.mpr hj0))
        (not_le.mpr hj)
    rw [Finset.sum_eq_single i₀ ?_ (by simp)]
    · -- the surviving term
      have hX : (MvPowerSeries.X i₀ : MvPowerSeries (Fin m) L) =
          MvPowerSeries.monomial (Finsupp.single i₀ 1) 1 := rfl
      rw [hX, MvPowerSeries.coeff_monomial_mul, if_pos
        (by
          rw [Finsupp.single_le_iff]
          exact Nat.one_le_iff_ne_zero.mpr hti₀), one_mul,
        originSlice_coeff, if_pos (fun j hj => by
          rw [Finsupp.tsub_apply, hmin j hj]
          simp)]
      congr 1
      rw [tsub_add_cancel_of_le (by
        rw [Finsupp.single_le_iff]
        exact Nat.one_le_iff_ne_zero.mpr hti₀)]
    · -- all other indices die
      intro i _ hii₀
      have hX : (MvPowerSeries.X i : MvPowerSeries (Fin m) L) =
          MvPowerSeries.monomial (Finsupp.single i 1) 1 := rfl
      rw [hX, MvPowerSeries.coeff_monomial_mul]
      rcases lt_or_gt_of_ne hii₀ with hlt | hgt
      · -- i < i₀: t i = 0, the monomial does not divide
        rw [if_neg (fun hle => ?_)]
        have h2 := Finsupp.single_le_iff.mp hle
        rw [hmin i hlt] at h2
        exact absurd h2 (by norm_num)
      · -- i > i₀: the slice condition fails at j = i₀
        by_cases hle : Finsupp.single i 1 ≤ t
        · rw [if_pos hle, originSlice_coeff, if_neg, mul_zero]
          intro hall
          have h3 := hall i₀ hgt
          rw [Finsupp.tsub_apply, Finsupp.single_apply,
            if_neg (by exact fun h => hii₀ h)] at h3
          exact hti₀ (by simpa using h3)
        · rw [if_neg hle]

section OriginIdeal

/-- The origin of the closed polydisc. -/
theorem norm_origin_le (i : Fin m) : ‖(0 : L)‖ ≤ 1 := by simp

/-- Evaluation at the origin is the constant coefficient. -/
theorem pointEval_origin (F : P L m) :
    pointEval (m := m) (fun _ => (0 : L)) (fun i => norm_origin_le i) F =
      MvPowerSeries.coeff 0 F.1 := by
  show (∑' v, mvEvalTerm (RingHom.id L) (fun _ => (0 : L))
    (toTopRestricted (m := m) F) v) = MvPowerSeries.coeff 0 F.1
  rw [tsum_eq_single 0]
  · show RingHom.id L (MvPowerSeries.coeff 0 F.1) * ∏ i, (0 : L) ^ ((0 : Fin m →₀ ℕ) i) = _
    simp
  · intro v hv
    show RingHom.id L (MvPowerSeries.coeff v F.1) * ∏ i, (0 : L) ^ (v i) = 0
    have hj : ∃ j, v j ≠ 0 := by
      by_contra hall
      push_neg at hall
      exact hv (Finsupp.ext fun j => hall j)
    obtain ⟨j, hj⟩ := hj
    rw [Finset.prod_eq_zero (Finset.mem_univ j)
      (by rw [zero_pow hj]), mul_zero]

/-- **The origin ideal is generated by the variables.** -/
theorem pointIdeal_origin_eq_span :
    pointIdeal (m := m) (fun _ => (0 : L)) (fun i => norm_origin_le i) =
      Ideal.span (Set.range fun i : Fin m => polyToP (MvPolynomial.X i)) := by
  ext F
  constructor
  · intro hF
    have h0 : MvPowerSeries.coeff 0 F.1 = 0 := by
      rw [← pointEval_origin]
      exact hF
    have hdec := origin_decomposition F
    rw [h0, map_zero, map_zero, zero_add] at hdec
    rw [hdec]
    exact Ideal.sum_mem _ fun i _ =>
      Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · intro hF
    have hle : Ideal.span
        (Set.range fun i : Fin m => polyToP (MvPolynomial.X i)) ≤
        pointIdeal (m := m) (fun _ => (0 : L)) (fun i => norm_origin_le i) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      show pointEval (m := m) _ _ (polyToP (MvPolynomial.X i)) = 0
      rw [pointEval_polyToP_X]
    exact hle hF

end OriginIdeal

end FiniteJet.GraphKoszul
