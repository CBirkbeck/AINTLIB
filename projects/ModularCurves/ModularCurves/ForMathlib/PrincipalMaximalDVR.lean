import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import Mathlib.RingTheory.Filtration

/-!
# Noetherian local rings whose maximal ideal is generated by a nonzerodivisor

A noetherian local ring `A` whose maximal ideal is generated by a single nonzerodivisor
`π` is a discrete valuation ring. This file proves the two steps:

* `IsLocalRing.exists_eq_pow_mul_unit_of_maximalIdeal_eq_span`: every nonzero `a : A`
  is `π ^ n * u` with `u` a unit — the order of vanishing of `a`, well defined because
  `⨅ n, (π) ^ n = ⊥` by Krull's intersection theorem
  (`Ideal.iInf_pow_eq_bot_of_isLocalRing`), and with unit cofactor by maximality of `n`.
* `IsDomain.of_maximalIdeal_eq_span_nonZeroDivisor`: such a ring is a domain — if
  `(π ^ m * u) * (π ^ n * v) = 0` with `u, v` units, then since `π ^ (m + n)` is a
  nonzerodivisor the unit `u * v` vanishes, contradicting nontriviality.
* `IsDiscreteValuationRing.of_maximalIdeal_eq_span`: a noetherian local domain whose
  maximal ideal is generated by a single nonzero element is a discrete valuation ring
  (via `IsDiscreteValuationRing.TFAE`).

Consumers chain the last two: `haveI := IsDomain.of_maximalIdeal_eq_span_nonZeroDivisor
A π hπ hm` and then apply the DVR lemma (in a domain, `π ∈ nonZeroDivisors A` is just
`π ≠ 0`, see `mem_nonZeroDivisors_iff_ne_zero`). This is the standard criterion showing
that a section cut out of a smooth curve by one equation has DVR-like local rings.

Upstream candidate: mathlib has Krull's intersection theorem and the DVR TFAE, but not
this bridge from "maximal ideal principal on a nonzerodivisor" to `IsDomain`
(`IsDiscreteValuationRing` requires `[IsDomain]` in its very type, so the domain step is
the essential content).
-/

open Ideal IsLocalRing

universe u

variable (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]

namespace IsLocalRing

/-- In a noetherian local ring whose maximal ideal is generated by `π`, every nonzero
element is `π ^ n * u` for some `n : ℕ` and some unit `u`. (No domain or nonzerodivisor
hypothesis is needed for this step.) -/
theorem exists_eq_pow_mul_unit_of_maximalIdeal_eq_span (π : A)
    (hm : maximalIdeal A = Ideal.span {π}) {a : A} (ha : a ≠ 0) :
    ∃ (n : ℕ) (u : A), IsUnit u ∧ a = π ^ n * u := by
  classical
  -- `a` avoids some power of the maximal ideal, by Krull's intersection theorem
  have hex : ∃ N : ℕ, a ∉ Ideal.span {π ^ N} := by
    by_contra hc
    refine ha (Ideal.mem_bot.mp ?_)
    rw [← Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal A) Ideal.IsPrime.ne_top']
    exact (Submodule.mem_iInf _).mpr fun i => by
      rw [hm, Ideal.span_singleton_pow]; exact not_exists_not.mp hc i
  -- the least power avoided is a successor, giving the order of vanishing `n`
  have hfind : Nat.find hex ≠ 0 := fun h0 => Nat.find_spec hex <| by
    rw [h0, pow_zero, Ideal.span_singleton_one]; exact Submodule.mem_top
  obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := Nat.exists_eq_succ_of_ne_zero hfind
  have hmem : a ∈ Ideal.span {π ^ n} :=
    not_not.mp (Nat.find_min hex (by rw [hn]; exact n.lt_succ_self))
  have hnot : a ∉ Ideal.span {π ^ (n + 1)} := by rw [← hn]; exact Nat.find_spec hex
  obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hmem
  refine ⟨n, u, ?_, by rw [mul_comm]; exact hu.symm⟩
  -- maximality of `n` forces the cofactor `u` to be a unit
  rw [← notMem_maximalIdeal, hm]
  intro humem
  obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp humem
  exact hnot (Ideal.mem_span_singleton'.mpr ⟨v, by rw [← hu, ← hv]; ring⟩)

end IsLocalRing

/-- A noetherian local ring whose maximal ideal is generated by a nonzerodivisor is a
domain (order-of-vanishing argument via Krull's intersection theorem). -/
theorem IsDomain.of_maximalIdeal_eq_span_nonZeroDivisor (π : A)
    (hπ : π ∈ nonZeroDivisors A) (hm : maximalIdeal A = Ideal.span {π}) :
    IsDomain A := by
  have : NoZeroDivisors A := by
    constructor
    intro a b hab
    by_contra hne
    obtain ⟨ha, hb⟩ := not_or.mp hne
    obtain ⟨m, u, hu, rfl⟩ := exists_eq_pow_mul_unit_of_maximalIdeal_eq_span A π hm ha
    obtain ⟨n, v, hv, rfl⟩ := exists_eq_pow_mul_unit_of_maximalIdeal_eq_span A π hm hb
    have h0 : u * v * π ^ (m + n) = 0 := by rw [← hab]; ring
    exact (hu.mul hv).ne_zero
      ((mul_right_mem_nonZeroDivisors_eq_zero_iff (pow_mem hπ _)).mp h0)
  exact NoZeroDivisors.to_isDomain A

/-- A noetherian local domain whose maximal ideal is generated by a single nonzero
element is a discrete valuation ring. -/
theorem IsDiscreteValuationRing.of_maximalIdeal_eq_span [IsDomain A] (π : A)
    (hπ : π ≠ 0) (hm : maximalIdeal A = Ideal.span {π}) :
    IsDiscreteValuationRing A := by
  have hfield : ¬IsField A := fun hf =>
    hπ (Ideal.span_singleton_eq_bot.mp (hm ▸ isField_iff_maximalIdeal_eq.mp hf))
  have hprin : (maximalIdeal A).IsPrincipal := ⟨⟨π, hm⟩⟩
  exact ((IsDiscreteValuationRing.TFAE A hfield).out 1 5).mpr hprin
