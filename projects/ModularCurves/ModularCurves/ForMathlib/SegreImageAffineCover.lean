import ModularCurves.ForMathlib.MvPolynomialProjectiveClosure
import ModularCurves.ForMathlib.SegreImageProj

/-!
# Standard affine charts on the Segre image

The images of the standard Segre coordinates are homogeneous of degree one
and generate an ideal containing the irrelevant ideal. They therefore give
a finite affine open cover of the `Proj` of the Segre image algebra.
-/

open AlgebraicGeometry
open HomogeneousIdeal
open TopologicalSpace

noncomputable section

universe u

namespace MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

/-- A standard homogeneous coordinate of the Segre image algebra. -/
def segreImageCoordinate
    (R : Type u) [CommRing R] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    SegreCoordinateRing R m n :=
  segreRangeCoordinateHom R m n (X i)

lemma segreImageCoordinate_mem_degreeOne
    (R : Type u) [CommRing R] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    segreImageCoordinate R m n i ∈ segreImageGrading R m n 1 :=
  segreRangeCoordinateHom_mem_imageGrading R m n
    (X_mem_homogeneousSubmodule_one R i)

/-- The irrelevant ideal is contained in the ideal generated by the standard coordinates. -/
lemma segreImageIrrelevant_le_coordinateIdeal
    (R : Type u) [CommRing R] (m n : ℕ) :
    (segreImageGrading R m n)₊.toIdeal ≤
      Ideal.span (Set.range (segreImageCoordinate R m n)) := by
  have hmap :
      Ideal.map (segreImageGradedHom R m n)
          ((homogeneousSubmodule (Fin (segreDimension m n + 1)) R)₊).toIdeal ≤
        Ideal.span (Set.range (segreImageCoordinate R m n)) := by
    refine (Ideal.map_mono
      (irrelevant_toIdeal_le_span_range_X
        (R := R) (σ := Fin (segreDimension m n + 1)))).trans ?_
    rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨i, rfl⟩
  intro x hx
  exact hmap (segreImageIrrelevant_le R m n hx)

/-- The standard coordinate chart on the `Proj` of the Segre image. -/
def segreImageStandardChart
    (R : Type u) [CommRing R] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    (segreImageProj R m n).Opens := by
  letI : AddSubgroupClass (Submodule R (SegreCoordinateRing R m n))
      (SegreCoordinateRing R m n) :=
    @Submodule.addSubgroupClass R (SegreCoordinateRing R m n) _ _ inferInstance
  exact Proj.basicOpen
    (segreImageGrading R m n)
    (segreImageCoordinate R m n i)

lemma iSup_segreImageStandardChart
    (R : Type u) [CommRing R] (m n : ℕ) :
    ⨆ i, segreImageStandardChart R m n i = ⊤ := by
  letI : AddSubgroupClass (Submodule R (SegreCoordinateRing R m n))
      (SegreCoordinateRing R m n) :=
    @Submodule.addSubgroupClass R (SegreCoordinateRing R m n) _ _ inferInstance
  exact Proj.iSup_basicOpen_eq_top
    (segreImageGrading R m n)
    (segreImageCoordinate R m n)
    (segreImageIrrelevant_le_coordinateIdeal R m n)

/-- The standard Segre-image charts as a finite affine open cover. -/
def segreImageAffineOpenCover
    (R : Type u) [CommRing R] (m n : ℕ) :
    (segreImageProj R m n).AffineOpenCover := by
  letI : AddSubgroupClass (Submodule R (SegreCoordinateRing R m n))
      (SegreCoordinateRing R m n) :=
    @Submodule.addSubgroupClass R (SegreCoordinateRing R m n) _ _ inferInstance
  exact Proj.affineOpenCoverOfIrrelevantLESpan
    (segreImageGrading R m n)
    (segreImageCoordinate R m n)
    (m := fun _ => 1)
    (segreImageCoordinate_mem_degreeOne R m n)
    (fun _ => Nat.zero_lt_one)
    (segreImageIrrelevant_le_coordinateIdeal R m n)

@[simp]
lemma segreImageAffineOpenCover_opensRange
    (R : Type u) [CommRing R] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    @Scheme.Hom.opensRange _ _
        ((segreImageAffineOpenCover R m n).f i)
        ((segreImageAffineOpenCover R m n).map_prop i) =
      segreImageStandardChart R m n i := by
  letI : AddSubgroupClass (Submodule R (SegreCoordinateRing R m n))
      (SegreCoordinateRing R m n) :=
    @Submodule.addSubgroupClass R (SegreCoordinateRing R m n) _ _ inferInstance
  exact Proj.opensRange_awayι
    (segreImageGrading R m n)
    (segreImageCoordinate R m n i)
    (segreImageCoordinate_mem_degreeOne R m n i)
    Nat.zero_lt_one

end MvPolynomial
