/-!
# Stalks of standard-smooth curves over a field are discrete valuation rings

For `A` a standard-smooth `k`-algebra of relative dimension `1` over a field `k`, the
local rings of `Spec A` at points of any finite closed subscheme are discrete valuation
rings, and consequently:

* `ModularCurves.exists_span_nonZeroDivisor_map_localizationAtPrime`: an ideal `I ≤ q`
  with finite-dimensional quotient `A ⧸ I` localizes at `q` to a principal ideal
  generated by a nonzerodivisor.
* `ModularCurves.mem_nonZeroDivisors_of_finite_quotient`: an element `f` with
  finite-dimensional quotient `A ⧸ (f)` is a nonzerodivisor.

The route avoids all regularity theory: near any prime, a Kähler-differential
coordinate `g` (with `dg` generating the rank-one module `Ω[A⁄k]`) exhibits an
away-localization of `A` as formally smooth over `k[X]` via the Jacobi–Zariski sequence,
hence smooth, hence flat; étale-fibre analysis over `k[X]` (`RingTheory/Etale/Field`)
identifies the maximal ideal of the stalk as the extension of the (principal) maximal
ideal downstairs, and the principal-maximal-ideal criterion
(`ModularCurves.ForMathlib.PrincipalMaximalDVR`) concludes. The finiteness hypothesis
kills the generic (field-stalk) case: `k[X]` embeds torsion-freely into the stalk,
which in that case is a localization of the finite-dimensional algebra `A ⧸ I`.
-/

universe u

namespace ModularCurves

/-- Expansion of an element of a module with a singleton basis. -/
private theorem stalkDVRAux_basis_expand {B : Type u} [CommRing B] {M : Type*}
    [AddCommGroup M] [Module B M] {ι : Type*} [Unique ι] (b : Module.Basis ι B M)
    (m : M) : m = b.repr m default • b default := by
  apply b.repr.injective
  refine Finsupp.ext fun j => ?_
  obtain rfl : j = default := Unique.eq_default j
  simp [Module.Basis.repr_self, smul_eq_mul]

/-- For a nontrivial standard-smooth algebra of relative dimension `1`, the chosen basis
index type of the (free, rank-one) module `Ω[B⁄K]` is a singleton. -/
@[reducible]
private noncomputable def stalkDVRAux_unique_index (K B : Type u) [CommRing K] [CommRing B]
    [Algebra K B] [Nontrivial B] [Algebra.IsStandardSmoothOfRelativeDimension 1 K B] :
    haveI : Algebra.IsStandardSmooth K B :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
    Unique (Module.Free.ChooseBasisIndex B (Ω[B⁄K])) := by
  haveI : Algebra.IsStandardSmooth K B :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
  have hrank : Module.rank B (Ω[B⁄K]) = 1 :=
    Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential 1
  have h1 : Cardinal.mk (Module.Free.ChooseBasisIndex B (Ω[B⁄K])) = 1 := by
    rw [← Module.Free.rank_eq_card_chooseBasisIndex, hrank]
  rw [Cardinal.eq_one_iff_unique] at h1
  exact @Unique.mk' _ ⟨Classical.choice h1.2⟩ h1.1

/-- Coordinate extraction: some element `g` has the coordinate of `dg` (in a singleton
basis of `Ω[B⁄K]`) outside any given prime `q`. -/
private theorem stalkDVRAux_exists_coord_notMem {K B : Type u} [CommRing K] [CommRing B]
    [Algebra K B] {ι : Type*} [Unique ι] (b : Module.Basis ι B (Ω[B⁄K]))
    (q : Ideal B) [q.IsPrime] :
    ∃ g : B, b.repr (KaehlerDifferential.D K B g) default ∉ q := by
  by_contra hall
  push Not at hall
  have hmem : (b default : Ω[B⁄K])
      ∈ Submodule.span B (Set.range (KaehlerDifferential.D K B)) := by
    rw [KaehlerDifferential.span_range_derivation]; trivial
  have key : ∀ m ∈ Submodule.span B (Set.range (KaehlerDifferential.D K B)),
      b.repr m default ∈ q := by
    intro m hm
    induction hm using Submodule.span_induction with
    | mem m hm => obtain ⟨x, rfl⟩ := hm; exact hall x
    | zero => simp
    | add m₁ m₂ _ _ ih₁ ih₂ => rw [map_add, Finsupp.add_apply]; exact q.add_mem ih₁ ih₂
    | smul a m _ ih =>
      rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
      exact q.mul_mem_left a ih
  have h1 : (1 : B) ∈ q := by
    have := key _ hmem
    rwa [Module.Basis.repr_self, Finsupp.single_eq_same] at this
  exact ‹q.IsPrime›.ne_top (q.eq_top_iff_one.mpr h1)

open TensorProduct in
/-- **Jacobi–Zariski core.** If `B` is standard-smooth of relative dimension one over a
field `K` and carries a `K[X]`-algebra structure for which `d(X·1_B)` generates
`Ω[B⁄K]`, then `B` is smooth over `K[X]` and `Ω[B⁄K[X]] = 0`. -/
private theorem stalkDVRAux_jz {K B : Type u} [Field K] [CommRing B] [Algebra K B]
    [Nontrivial B] [Algebra.IsStandardSmoothOfRelativeDimension 1 K B]
    [Algebra (Polynomial K) B] [IsScalarTower K (Polynomial K) B]
    (hgen : ∀ m : Ω[B⁄K], ∃ a : B,
      m = a • KaehlerDifferential.D K B (algebraMap (Polynomial K) B Polynomial.X)) :
    Algebra.Smooth (Polynomial K) B ∧ Subsingleton (Ω[B⁄Polynomial K]) := by
  classical
  haveI : Algebra.IsStandardSmooth K B :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
  haveI := stalkDVRAux_unique_index K B
  -- `a • d(X·1) = 0` forces `a = 0`
  have hreg : ∀ a : B,
      a • KaehlerDifferential.D K B (algebraMap (Polynomial K) B Polynomial.X) = 0 →
      a = 0 := by
    intro a ha
    set b' := Module.Free.chooseBasis B (Ω[B⁄K]) with hb'def
    obtain ⟨e, he⟩ := hgen (b' default)
    set c : B := b'.repr
      (KaehlerDifferential.D K B (algebraMap (Polynomial K) B Polynomial.X)) default
      with hcdef
    have h2 : e * c = 1 := by
      have h3 := congrArg (fun m => b'.repr m default) he
      simp only [map_smul, Finsupp.smul_apply, smul_eq_mul,
        Module.Basis.repr_self, Finsupp.single_eq_same] at h3
      exact h3.symm
    have h4 : a * c = 0 := by
      have h5 := congrArg (fun m => b'.repr m default) ha
      simp only [map_smul, Finsupp.smul_apply, smul_eq_mul, map_zero,
        Finsupp.zero_apply] at h5
      exact h5
    calc a = a * (c * e) := by rw [mul_comm c e, h2, mul_one]
    _ = a * c * e := by ring
    _ = 0 := by rw [h4, zero_mul]
  -- `Ω[B⁄K[X]] = 0`
  have hΩP : Subsingleton (Ω[B⁄Polynomial K]) := by
    have hzero : ∀ x : B, KaehlerDifferential.D (Polynomial K) B x = 0 := by
      intro x
      obtain ⟨a, ha⟩ := hgen (KaehlerDifferential.D K B x)
      have h1 := congrArg (KaehlerDifferential.map K (Polynomial K) B B) ha
      rw [KaehlerDifferential.map_D, map_smul, KaehlerDifferential.map_D] at h1
      rw [show algebraMap B B x = x from by simp] at h1
      rw [show algebraMap B B (algebraMap (Polynomial K) B Polynomial.X)
          = algebraMap (Polynomial K) B Polynomial.X from by simp] at h1
      rw [Derivation.map_algebraMap, smul_zero] at h1
      exact h1
    refine subsingleton_of_forall_eq 0 fun m => ?_
    have hm : m ∈ Submodule.span B
        (Set.range (KaehlerDifferential.D (Polynomial K) B)) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    induction hm using Submodule.span_induction with
    | mem m hm => obtain ⟨x, rfl⟩ := hm; exact hzero x
    | zero => rfl
    | add m₁ m₂ _ _ ih₁ ih₂ => rw [ih₁, ih₂, add_zero]
    | smul a m _ ih => rw [ih, smul_zero]
  -- representation of the base-changed differentials
  have hrep : ∀ t : B ⊗[Polynomial K] (Ω[Polynomial K⁄K]), ∃ a : B, t = a •
      ((1 : B) ⊗ₜ[Polynomial K]
        KaehlerDifferential.D K (Polynomial K) Polynomial.X) := by
    intro t
    induction t with
    | zero => exact ⟨0, by simp⟩
    | tmul p ω =>
      obtain ⟨q, rfl⟩ : ∃ q : Polynomial K,
          ω = q • KaehlerDifferential.D K (Polynomial K) Polynomial.X := by
        refine ⟨KaehlerDifferential.polynomialEquiv K ω, ?_⟩
        conv_lhs =>
          rw [← (KaehlerDifferential.polynomialEquiv K).symm_apply_apply ω]
        rfl
      refine ⟨algebraMap (Polynomial K) B q * p, ?_⟩
      have e1 : p ⊗ₜ[Polynomial K] (q • KaehlerDifferential.D K (Polynomial K) Polynomial.X)
          = (algebraMap (Polynomial K) B q * p) ⊗ₜ[Polynomial K]
            KaehlerDifferential.D K (Polynomial K) Polynomial.X := by
        rw [TensorProduct.tmul_smul, ← algebraMap_smul B q, TensorProduct.smul_tmul',
          smul_eq_mul]
      rw [e1, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    | add t₁ t₂ ih₁ ih₂ =>
      obtain ⟨a₁, rfl⟩ := ih₁
      obtain ⟨a₂, rfl⟩ := ih₂
      exact ⟨a₁ + a₂, by rw [add_smul]⟩
  -- injectivity of the base-change map
  have hker : ∀ t : B ⊗[Polynomial K] (Ω[Polynomial K⁄K]),
      KaehlerDifferential.mapBaseChange K (Polynomial K) B t = 0 → t = 0 := by
    intro t ht
    obtain ⟨a, rfl⟩ := hrep t
    rw [map_smul] at ht
    have h2 : KaehlerDifferential.mapBaseChange K (Polynomial K) B
        ((1 : B) ⊗ₜ[Polynomial K]
          KaehlerDifferential.D K (Polynomial K) Polynomial.X)
        = KaehlerDifferential.D K B (algebraMap (Polynomial K) B Polynomial.X) := by
      rw [KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D, one_smul]
    rw [h2] at ht
    rw [hreg a ht, zero_smul]
  -- formal smoothness via the Jacobi–Zariski sequence
  haveI hFS : Algebra.FormallySmooth (Polynomial K) B := by
    rw [Algebra.formallySmooth_iff]
    refine ⟨?_, ?_⟩
    · haveI := hΩP
      haveI : Module.Free B (Ω[B⁄Polynomial K]) := Module.Free.of_subsingleton B _
      infer_instance
    · refine subsingleton_of_forall_eq 0 fun x => ?_
      have hδ : Algebra.H1Cotangent.δ K (Polynomial K) B x = 0 :=
        hker _ ((Algebra.H1Cotangent.exact_δ_mapBaseChange
          K (Polynomial K) B).apply_apply_eq_zero x)
      obtain ⟨y, hy⟩ :=
        (Algebra.H1Cotangent.exact_map_δ K (Polynomial K) B x).mp hδ
      rw [← hy, Subsingleton.elim y 0, map_zero]
  haveI hFP : Algebra.FinitePresentation (Polynomial K) B :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation
      (R := K) (A := Polynomial K) (B := B)
  exact ⟨⟨hFS, hFP⟩, hΩP⟩

/-- A localized quotient of a finite-dimensional quotient is finite-dimensional:
if `B ⧸ I` is a finite `K`-module and `S` is a localization of `B`, then
`S ⧸ I·S` is a finite `K`-module (being a quotient of the Artinian ring `B ⧸ I`). -/
private theorem stalkDVRAux_finite_quotient_loc {K B : Type u} [Field K] [CommRing B]
    [Algebra K B] (M : Submonoid B) (S : Type u) [CommRing S] [Algebra B S] [Algebra K S]
    [IsScalarTower K B S] [IsLocalization M S] (I : Ideal B)
    (hfin : Module.Finite K (B ⧸ I)) :
    Module.Finite K (S ⧸ I.map (algebraMap B S)) := by
  haveI : IsArtinianRing (B ⧸ I) := IsArtinianRing.of_finite K (B ⧸ I)
  haveI : IsScalarTower K (B ⧸ I) (S ⧸ I.map (algebraMap B S)) := by
    refine IsScalarTower.of_algebraMap_eq fun x => ?_
    rw [IsScalarTower.algebraMap_apply K B (B ⧸ I), Ideal.Quotient.algebraMap_eq]
    show algebraMap K (S ⧸ I.map (algebraMap B S)) x
      = Ideal.quotientMap (I.map (algebraMap B S)) (algebraMap B S) Ideal.le_comap_map
        (Ideal.Quotient.mk I (algebraMap K B x))
    rw [Ideal.quotientMap_mk, ← IsScalarTower.algebraMap_apply K B S,
      IsScalarTower.algebraMap_apply K S (S ⧸ I.map (algebraMap B S)),
      Ideal.Quotient.algebraMap_eq]
  have hsurj : Function.Surjective
      (algebraMap (B ⧸ I) (S ⧸ I.map (algebraMap B S))) :=
    IsArtinianRing.localization_surjective (Algebra.algebraMapSubmonoid (B ⧸ I) M) _
  haveI : Module.Finite (B ⧸ I) (S ⧸ I.map (algebraMap B S)) :=
    Module.Finite.of_surjective
      (Algebra.linearMap (B ⧸ I) (S ⧸ I.map (algebraMap B S))) hsurj
  exact Module.Finite.trans (B ⧸ I) (S ⧸ I.map (algebraMap B S))

/-- Finiteness of quotients is antitone in the ideal. -/
private theorem stalkDVRAux_finite_quotient_le {K B : Type u} [Field K] [CommRing B]
    [Algebra K B] {I J : Ideal B} (hIJ : I ≤ J)
    (hfin : Module.Finite K (B ⧸ I)) : Module.Finite K (B ⧸ J) := by
  have hle : I ≤ J.comap (AlgHom.id K B) := hIJ
  have hs : Function.Surjective (Ideal.quotientMapₐ J (AlgHom.id K B) hle) := by
    intro z
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨Ideal.Quotient.mk I y, by simp⟩
  exact Module.Finite.of_surjective (Ideal.quotientMapₐ J (AlgHom.id K B) hle).toLinearMap hs

/-- The localization of a ring away from an element lying outside a prime ideal is
nontrivial (the element is non-nilpotent, so no power of it vanishes). -/
private theorem stalkDVRAux_nontrivial_localizationAway {A : Type u} [CommRing A] {r : A}
    (q : Ideal A) [q.IsPrime] (hr : r ∉ q) : Nontrivial (Localization.Away r) := by
  rcases subsingleton_or_nontrivial (Localization.Away r) with hsub | h
  · exfalso
    have h0 : algebraMap A (Localization.Away r) 1 = 0 := Subsingleton.elim _ _
    rw [IsLocalization.map_eq_zero_iff (Submonoid.powers r)] at h0
    obtain ⟨m, hm⟩ := h0
    obtain ⟨n, hn⟩ := m.2
    refine hr (‹q.IsPrime›.mem_of_pow_mem n ?_)
    have hrn0 : r ^ n = 0 := by
      have hm0 : (m : A) = 0 := by simpa using hm
      simpa [hm0] using hn
    rw [hrn0]; exact q.zero_mem
  · exact h

/-- **Kähler generator on an away-localization.** If `b` is a singleton basis of the
rank-one module `Ω[A⁄k]` and `A'` is the localization of `A` inverting the coordinate
`r = b.repr (dg)` of `dg`, then every differential in `Ω[A'⁄k]` is an `A'`-multiple of
`d(g)` (the image of `g` in `A'`). -/
private theorem stalkDVRAux_kaehler_gen {k A A' : Type u} [CommRing k] [CommRing A]
    [Algebra k A] [CommRing A'] [Algebra A A'] [Algebra k A'] [IsScalarTower k A A']
    {ι : Type*} [Unique ι] (b : Module.Basis ι A (Ω[A⁄k])) (g : A)
    [IsLocalization (Submonoid.powers (b.repr (KaehlerDifferential.D k A g) default)) A'] :
    ∀ m : Ω[A'⁄k], ∃ a : A',
      m = a • KaehlerDifferential.D k A' (algebraMap A A' g) := by
  set r : A := b.repr (KaehlerDifferential.D k A g) default with hrdef
  have hgu : IsUnit (algebraMap A A' r) :=
    IsLocalization.map_units A' (⟨r, Submonoid.mem_powers r⟩ : Submonoid.powers r)
  have hDt : KaehlerDifferential.D k A' (algebraMap A A' g)
      = algebraMap A A' r • KaehlerDifferential.map k k A A' (b default) := by
    rw [← KaehlerDifferential.map_D k k A A' g]
    conv_lhs => rw [stalkDVRAux_basis_expand b (KaehlerDifferential.D k A g)]
    rw [map_smul, algebraMap_smul]
  obtain ⟨u, hu⟩ := hgu
  have hb0 : KaehlerDifferential.map k k A A' (b default)
      = (↑u⁻¹ : A') • KaehlerDifferential.D k A' (algebraMap A A' g) := by
    rw [hDt, ← hu, smul_smul, Units.inv_mul, one_smul]
  intro m
  have hm : m ∈ Submodule.span A'
      (Set.range (KaehlerDifferential.map k k A A' ∘ KaehlerDifferential.D k A)) := by
    rw [KaehlerDifferential.span_range_map_derivation_of_isLocalization
      (R := k) (S := A) (T := A') (Submonoid.powers r)]
    trivial
  induction hm using Submodule.span_induction with
  | mem m hm =>
    obtain ⟨x, rfl⟩ := hm
    refine ⟨algebraMap A A' (b.repr (KaehlerDifferential.D k A x) default) * ↑u⁻¹, ?_⟩
    show KaehlerDifferential.map k k A A' (KaehlerDifferential.D k A x) = _
    conv_lhs => rw [stalkDVRAux_basis_expand b (KaehlerDifferential.D k A x)]
    rw [map_smul,
      show (b.repr (KaehlerDifferential.D k A x) default)
          • KaehlerDifferential.map k k A A' (b default)
        = algebraMap A A' (b.repr (KaehlerDifferential.D k A x) default)
          • KaehlerDifferential.map k k A A' (b default) from
        (algebraMap_smul A' _ _).symm,
      hb0, smul_smul]
  | zero => exact ⟨0, by simp⟩
  | add m₁ m₂ _ _ ih₁ ih₂ =>
    obtain ⟨a₁, rfl⟩ := ih₁
    obtain ⟨a₂, rfl⟩ := ih₂
    exact ⟨a₁ + a₂, by rw [add_smul]⟩
  | smul a m _ ih =>
    obtain ⟨a₀, rfl⟩ := ih
    exact ⟨a * a₀, by rw [smul_smul]⟩

/-- There is no injective `k`-algebra homomorphism from the polynomial ring `k[X]` into a
finite-dimensional `k`-algebra (`k[X]` is not module-finite over `k`). -/
private theorem stalkDVRAux_not_injective_algHom_polynomial {k C : Type u} [Field k]
    [CommRing C] [Algebra k C] [Module.Finite k C] (φ : Polynomial k →ₐ[k] C) :
    ¬ Function.Injective φ := fun hinj =>
  Polynomial.not_finite (FiniteDimensional.of_injective φ.toLinearMap hinj)

/-- Over a flat algebra, the image of a nonzerodivisor under the structure map is again a
nonzerodivisor. -/
private theorem stalkDVRAux_algebraMap_mem_nonZeroDivisors {R O : Type u} [CommRing R]
    [CommRing O] [Algebra R O] [Module.Flat R O] {p : R} (hp : p ∈ nonZeroDivisors R) :
    algebraMap R O p ∈ nonZeroDivisors O := by
  have hreg : IsSMulRegular O p := Module.Flat.isSMulRegular_of_nonZeroDivisors hp
  rw [mem_nonZeroDivisors_iff]
  constructor
  · intro x hx
    apply hreg
    show p • x = p • 0
    rw [smul_zero, Algebra.smul_def, hx]
  · intro x hx
    apply hreg
    show p • x = p • 0
    rw [smul_zero, Algebra.smul_def, mul_comm, hx]

/-- A discrete valuation ring is never module-finite over a field: it would be Artinian,
hence (being a domain) a field, contradicting that a DVR is not a field. -/
private theorem stalkDVRAux_not_finite_of_isDiscreteValuationRing {k O : Type u} [Field k]
    [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] [Algebra k O] :
    ¬ Module.Finite k O := by
  intro h
  haveI := h
  haveI : IsArtinianRing O := IsArtinianRing.of_finite k O
  exact IsDiscreteValuationRing.not_isField O (IsArtinianRing.isField_of_isDomain O)

variable (k A : Type u) [Field k] [CommRing A] [Algebra k A]
  [Algebra.IsStandardSmoothOfRelativeDimension 1 k A]

/-- **Stalkwise principality on a standard-smooth curve over a field**: an ideal `I`
contained in a prime `q`, with `A ⧸ I` finite-dimensional over `k`, generates a
principal ideal with nonzerodivisor generator in the local ring at `q` (which is a
discrete valuation ring). -/
theorem exists_span_nonZeroDivisor_map_localizationAtPrime (q : Ideal A) [q.IsPrime]
    (I : Ideal A) (hIq : I ≤ q) (hfin : Module.Finite k (A ⧸ I)) :
    ∃ f : Localization.AtPrime q,
      I.map (algebraMap A (Localization.AtPrime q)) = Ideal.span {f} ∧
      f ∈ nonZeroDivisors (Localization.AtPrime q) := by
  classical
  set O := Localization.AtPrime q with hOdef
  haveI : Nontrivial A := (algebraMap A O).domain_nontrivial
  haveI : Algebra.IsStandardSmooth k A :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
  haveI := stalkDVRAux_unique_index k A
  set b := Module.Free.chooseBasis A (Ω[A⁄k]) with hbdef
  -- coordinate extraction at `q`
  obtain ⟨g, hg⟩ := stalkDVRAux_exists_coord_notMem b q
  set r : A := b.repr (KaehlerDifferential.D k A g) default with hrdef
  -- the away-localization inverting `r`
  set A' := Localization.Away r with hA'def
  haveI : Nontrivial A' := stalkDVRAux_nontrivial_localizationAway q hg
  haveI hstdA' : Algebra.IsStandardSmoothOfRelativeDimension 1 k A' := by
    haveI h0 : Algebra.IsStandardSmoothOfRelativeDimension 0 A A' :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away r
    have h1 := Algebra.IsStandardSmoothOfRelativeDimension.trans
      (n := 1) (m := 0) k A A'
    simpa using h1
  haveI : Algebra.IsStandardSmooth k A' :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
  haveI := stalkDVRAux_unique_index k A'
  -- the prime `q'` of `A'` over `q`
  have hle : Submonoid.powers r ≤ q.primeCompl := by
    intro x hx
    obtain ⟨n, hn⟩ := hx
    intro hmem
    rw [← hn] at hmem
    exact hg (‹q.IsPrime›.mem_of_pow_mem n hmem)
  have hdisj : Disjoint (Submonoid.powers r : Set A) (q : Set A) :=
    Set.disjoint_left.mpr fun x hx hq => hle hx hq
  set q' : Ideal A' := q.map (algebraMap A A') with hq'def
  haveI hq'p : q'.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers r) A' q
      inferInstance hdisj
  have hq'c : q'.comap (algebraMap A A') = q :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers r) A'
      inferInstance hdisj
  -- `O` as the localization of `A'` at `q'`
  letI : Algebra A' O := IsLocalization.localizationAlgebraOfSubmonoidLe A' O
    (Submonoid.powers r) q.primeCompl hle
  haveI : IsScalarTower A A' O :=
    IsLocalization.localization_isScalarTower_of_submonoid_le A' O
      (Submonoid.powers r) q.primeCompl hle
  haveI : IsLocalization ((q.primeCompl).map (algebraMap A A')) O :=
    IsLocalization.isLocalization_of_submonoid_le A' O
      (Submonoid.powers r) q.primeCompl hle
  haveI hOq' : IsLocalization.AtPrime O q' := by
    refine IsLocalization.isLocalization_of_is_exists_mul_mem O
      ((q.primeCompl).map (algebraMap A A')) q'.primeCompl ?_ ?_
    · rintro _ ⟨s, hs, rfl⟩
      exact fun hmem => hs (hq'c ▸ Ideal.mem_comap.mpr hmem)
    · rintro ⟨x, hx⟩
      obtain ⟨⟨a, s⟩, e⟩ := IsLocalization.surj (Submonoid.powers r) x
      refine ⟨algebraMap A A' s, ?_⟩
      have ha : a ∈ q.primeCompl := by
        intro hmem
        apply hx
        have h1 : x * algebraMap A A' s ∈ q' := by
          rw [e]; exact Ideal.mem_map_of_mem _ hmem
        obtain ⟨v, hv⟩ := IsLocalization.map_units A' s
        have h2 : x = x * algebraMap A A' s * ↑v⁻¹ := by
          rw [← hv, mul_assoc, Units.mul_inv, mul_one]
        rw [h2]
        exact Ideal.mul_mem_right _ _ h1
      exact Submonoid.mem_map.mpr ⟨a, ha, by rw [mul_comm] at e; exact e.symm⟩
  -- the Kähler generator downstairs
  set t : A' := algebraMap A A' g with htdef
  have hgen : ∀ m : Ω[A'⁄k], ∃ a : A', m = a • KaehlerDifferential.D k A' t := by
    rw [htdef]; exact stalkDVRAux_kaehler_gen b g
  -- the polynomial algebra `k[X] → A'`, `X ↦ t`
  letI : Algebra (Polynomial k) A' := (Polynomial.aeval t).toRingHom.toAlgebra
  haveI : IsScalarTower k (Polynomial k) A' :=
    IsScalarTower.of_algebraMap_eq' (by
      ext r'
      exact (Polynomial.aeval_C t r').symm)
  have halgX : algebraMap (Polynomial k) A' Polynomial.X = t := Polynomial.aeval_X t
  obtain ⟨hSm, hΩ⟩ := stalkDVRAux_jz (K := k) (B := A')
    (by simpa only [halgX] using hgen)
  haveI : Algebra.FormallySmooth (Polynomial k) A' := hSm.1
  haveI : Algebra.FinitePresentation (Polynomial k) A' := hSm.2
  -- `k[X] → O` through `A'`
  letI : Algebra (Polynomial k) O :=
    ((algebraMap A' O).comp (algebraMap (Polynomial k) A')).toAlgebra
  haveI : IsScalarTower (Polynomial k) A' O := IsScalarTower.of_algebraMap_eq' rfl
  -- the contraction of `q'` to `k[X]`
  set q₀ : Ideal (Polynomial k) := q'.comap (algebraMap (Polynomial k) A') with hq₀def
  haveI : q₀.IsPrime := Ideal.IsPrime.comap (algebraMap (Polynomial k) A')
  rcases eq_or_ne q₀ ⊥ with hbot | hbot
  · -- generic case is impossible: `k[X]` would embed into a finite-dimensional algebra
    exfalso
    have hfinI' : Module.Finite k (A' ⧸ I.map (algebraMap A A')) :=
      stalkDVRAux_finite_quotient_loc (Submonoid.powers r) A' I hfin
    have hIq' : I.map (algebraMap A A') ≤ q' := Ideal.map_mono hIq
    haveI hfinq' : Module.Finite k (A' ⧸ q') :=
      stalkDVRAux_finite_quotient_le hIq' hfinI'
    refine stalkDVRAux_not_injective_algHom_polynomial
      ((Ideal.Quotient.mkₐ k q').comp (IsScalarTower.toAlgHom k (Polynomial k) A')) ?_
    rw [injective_iff_map_eq_zero]
    intro p hp
    have h1 : algebraMap (Polynomial k) A' p ∈ q' := by
      rwa [← Ideal.Quotient.eq_zero_iff_mem]
    have h2 : p ∈ q₀ := Ideal.mem_comap.mpr h1
    rw [hbot] at h2
    exact h2
  · -- `q₀` is a nonzero prime of the PID `k[X]`: maximal, with generator `p`
    haveI hq₀max : q₀.IsMaximal := IsPrime.to_maximal_ideal hbot
    haveI hprin : Submodule.IsPrincipal q₀ := IsPrincipalIdealRing.principal q₀
    obtain ⟨p, hp⟩ : ∃ p, q₀ = Ideal.span {p} :=
      ⟨Submodule.IsPrincipal.generator q₀, (Ideal.span_singleton_generator q₀).symm⟩
    have hp0 : p ≠ 0 := by
      intro h0
      exact hbot (by rw [hp, h0, Ideal.span_singleton_eq_bot.mpr rfl])
    set P₀ := Localization.AtPrime q₀ with hP₀def
    -- `P₀ → O`
    have hunits : ∀ y : q₀.primeCompl,
        IsUnit (algebraMap (Polynomial k) O y) := by
      intro y
      rw [IsScalarTower.algebraMap_apply (Polynomial k) A' O,
        IsLocalization.AtPrime.isUnit_to_map_iff O q']
      exact fun hmem => y.2 (Ideal.mem_comap.mpr hmem)
    letI : Algebra P₀ O := (IsLocalization.lift hunits).toAlgebra
    haveI : IsScalarTower (Polynomial k) P₀ O :=
      IsScalarTower.of_algebraMap_eq' (IsLocalization.lift_comp hunits).symm
    haveI : IsLocalHom (algebraMap P₀ O) := by
      constructor
      intro x hx
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective q₀.primeCompl x
      rw [IsLocalization.AtPrime.isUnit_mk'_iff]
      intro ha
      have h2 : algebraMap P₀ O (IsLocalization.mk' P₀ a s)
          * algebraMap (Polynomial k) O s = algebraMap (Polynomial k) O a := by
        rw [IsScalarTower.algebraMap_apply (Polynomial k) P₀ O,
          IsScalarTower.algebraMap_apply (Polynomial k) P₀ O, ← map_mul,
          IsLocalization.mk'_spec]
      have h1 : IsUnit (algebraMap (Polynomial k) O a) := h2 ▸ hx.mul (hunits s)
      rw [IsScalarTower.algebraMap_apply (Polynomial k) A' O,
        IsLocalization.AtPrime.isUnit_to_map_iff O q'] at h1
      exact h1 (Ideal.mem_comap.mp ha)
    -- unramifiedness and essential finiteness of `P₀ → O`
    haveI hUnrA' : Algebra.FormallyUnramified (Polynomial k) A' := ⟨hΩ⟩
    haveI : Algebra.FormallyUnramified A' O :=
      Algebra.FormallyUnramified.of_isLocalization q'.primeCompl
    haveI : Algebra.FormallyUnramified (Polynomial k) O :=
      Algebra.FormallyUnramified.comp (Polynomial k) A' O
    haveI : Algebra.FormallyUnramified P₀ O :=
      Algebra.FormallyUnramified.of_restrictScalars (Polynomial k) P₀ O
    haveI : Algebra.EssFiniteType A' O :=
      Algebra.EssFiniteType.of_isLocalization O q'.primeCompl
    haveI : Algebra.EssFiniteType (Polynomial k) O :=
      Algebra.EssFiniteType.comp (Polynomial k) A' O
    haveI : Algebra.EssFiniteType P₀ O :=
      Algebra.EssFiniteType.of_comp (Polynomial k) P₀ O
    -- the uniformizer
    set π : O := algebraMap (Polynomial k) O p with hπdef
    have hmO : IsLocalRing.maximalIdeal O = Ideal.span {π} := by
      have h1 := Algebra.FormallyUnramified.map_maximalIdeal (R := P₀) (S := O)
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q₀ P₀, Ideal.map_map,
        ← IsScalarTower.algebraMap_eq (Polynomial k) P₀ O, hp, Ideal.map_span,
        Set.image_singleton] at h1
      exact h1.symm
    -- flatness over `k[X]`, hence `π` is a nonzerodivisor
    haveI : Module.Flat (Polynomial k) A' := Algebra.Smooth.flat _ _
    haveI : Module.Flat A' O := IsLocalization.flat O q'.primeCompl
    haveI : Module.Flat (Polynomial k) O := Module.Flat.trans (Polynomial k) A' O
    have hπnzd : π ∈ nonZeroDivisors O :=
      stalkDVRAux_algebraMap_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hp0)
    -- `O` is a noetherian local ring
    haveI : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
    haveI : IsNoetherianRing O :=
      IsLocalization.isNoetherianRing q.primeCompl O ‹IsNoetherianRing A›
    -- the DVR structure
    haveI : IsDomain O := IsDomain.of_maximalIdeal_eq_span_nonZeroDivisor O π hπnzd hmO
    have hπ0 : π ≠ 0 := nonZeroDivisors.ne_zero hπnzd
    haveI : IsDiscreteValuationRing O :=
      IsDiscreteValuationRing.of_maximalIdeal_eq_span O π hπ0 hmO
    -- `I·O` is nonzero, since `O` is not finite-dimensional over `k`
    have hIO : I.map (algebraMap A O) ≠ ⊥ := by
      intro hbot0
      have hfinIO : Module.Finite k (O ⧸ I.map (algebraMap A O)) :=
        stalkDVRAux_finite_quotient_loc q.primeCompl O I hfin
      have hmk : Function.Bijective (Ideal.Quotient.mkₐ k (I.map (algebraMap A O))) := by
        constructor
        · rw [injective_iff_map_eq_zero]
          intro a ha
          rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, hbot0] at ha
          exact ha
        · exact Ideal.Quotient.mkₐ_surjective k _
      haveI : Module.Finite k O := Module.Finite.equiv
        (LinearEquiv.ofBijective (Ideal.Quotient.mkₐ k _).toLinearMap hmk).symm
      exact stalkDVRAux_not_finite_of_isDiscreteValuationRing ‹Module.Finite k O›
    -- classification of ideals in the DVR `O`
    have hirr : Irreducible π :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hmO
    obtain ⟨n, hn⟩ :=
      IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hIO hirr
    exact ⟨π ^ n, hn, pow_mem hπnzd n⟩

/-- On a standard-smooth curve over a field, an element cutting out a
finite-dimensional quotient is a nonzerodivisor (its vanishing locus misses every
generic point; stalkwise the local rings are fields or discrete valuation rings). -/
theorem mem_nonZeroDivisors_of_finite_quotient (f : A)
    (hfin : Module.Finite k (A ⧸ Ideal.span {f})) : f ∈ nonZeroDivisors A := by
  rw [mem_nonZeroDivisors_iff]
  suffices key : ∀ x : A, x * f = 0 → x = 0 by
    exact ⟨fun x hx => key x (by rwa [mul_comm] at hx), key⟩
  intro x hx
  by_contra hx0
  -- a maximal ideal above the annihilator of `x`
  have hJ : (Submodule.span A {x}).annihilator ≠ ⊤ := by
    intro h
    refine hx0 ?_
    have h1 : (1 : A) ∈ (Submodule.span A {x}).annihilator := h ▸ Submodule.mem_top
    rw [Submodule.mem_annihilator_span_singleton, one_smul] at h1
    exact h1
  obtain ⟨m, hmax, hJm⟩ := Ideal.exists_le_maximal _ hJ
  haveI := hmax.isPrime
  set O := Localization.AtPrime m with hOdef
  -- `x` survives in the localization at `m`
  have hx1 : algebraMap A O x ≠ 0 := by
    intro h0
    rw [IsLocalization.map_eq_zero_iff m.primeCompl] at h0
    obtain ⟨s, hs⟩ := h0
    refine s.2 (hJm ?_)
    rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul]
    exact hs
  have hxf : algebraMap A O x * algebraMap A O f = 0 := by
    rw [← map_mul, hx, map_zero]
  by_cases hfm : f ∈ m
  · -- at primes containing `f`, use the principality theorem
    obtain ⟨gg, hspan, hgg⟩ := exists_span_nonZeroDivisor_map_localizationAtPrime k A m
      (Ideal.span {f}) (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hfm)) hfin
    rw [Ideal.map_span, Set.image_singleton] at hspan
    have hf1 : algebraMap A O f ∈ Ideal.span {gg} :=
      hspan ▸ Ideal.subset_span (Set.mem_singleton _)
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hf1
    have hg1 : gg ∈ Ideal.span {algebraMap A O f} :=
      hspan.symm ▸ Ideal.subset_span (Set.mem_singleton _)
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hg1
    -- `c` is a unit, so the image of `f` is a nonzerodivisor
    have h1 : (1 - d * c) * gg = 0 := by
      calc (1 - d * c) * gg = gg - d * (c * gg) := by ring
      _ = 0 := by rw [hc, hd, sub_self]
    have hdc : 1 - d * c = 0 := (mem_nonZeroDivisors_iff.mp hgg).2 _ h1
    have hcu : IsUnit c :=
      (Units.mkOfMulEqOne c d (by rw [mul_comm]; linear_combination -hdc)).isUnit
    have hfnzd : algebraMap A O f ∈ nonZeroDivisors O :=
      hc ▸ Submonoid.mul_mem _ hcu.mem_nonZeroDivisors hgg
    exact hx1 ((mem_nonZeroDivisors_iff.mp hfnzd).2 _ hxf)
  · -- at primes not containing `f`, the image of `f` is a unit
    have hu : IsUnit (algebraMap A O f) :=
      IsLocalization.map_units O (⟨f, hfm⟩ : m.primeCompl)
    exact hx1 ((mem_nonZeroDivisors_iff.mp hu.mem_nonZeroDivisors).2 _ hxf)

end ModularCurves
