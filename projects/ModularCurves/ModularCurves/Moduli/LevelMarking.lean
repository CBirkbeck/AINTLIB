import ModularCurves.Moduli.SectionMarking
import ModularCurves.Moduli.GammaH
import ModularCurves.EllipticCurve.TorsionFibre

/-!
# Level sections avoid the zero section ([hArb-2c])

**(STREAM-OMEGA 2026-07-17.)** The marked pair of a naive full level-`N` structure is
fibrewise nonzero for `N > 1`: if a marked section pulled to an algebraically closed
geometric point were zero, the geometric `N`-torsion — of cardinality `N²` by the KM
count (`torsion_geometricFibre_rank_two`) — would be generated by the single remaining
point, giving a surjection from `ZMod N` and the contradiction `N² ≤ N`.

Combined with `marksAt_of_forall_pull_ne_zero` ([hArb-2]), every marked level section
gets honest chart coordinates on every affine piece of the base.
-/

universe u

noncomputable section

namespace ModularCurves

open AlgebraicGeometry CategoryTheory

namespace EllipticCurve

variable {S : Scheme.{u}} (E : EllipticCurve S)

set_option backward.isDefEq.respectTransparency false in
set_option maxHeartbeats 1600000 in
/-- **([hArb-2c] core)** If the geometric `N`-torsion has an `(ℤ/N)²`-count and is
generated by a SINGLE `N`-torsion point, then `N ≤ 1`. -/
theorem le_one_of_torsion_generated_by_single (N : ℕ) [NeZero N]
    {k : Type u} [Field k] [IsAlgClosed k] {t : Spec (CommRingCat.of k) ⟶ S}
    (hNk : (N : k) ≠ 0) (Q₀ : E.Point t) (hQ₀ : (N : ℤ) • Q₀ = 0)
    (hgen : ∀ x : E.Point t, (N : ℤ) • x = 0 →
      ∃ n : ℤ, n • Q₀ = x) :
    N ≤ 1 := by
  obtain ⟨e⟩ := E.torsion_geometricFibre_rank_two N k t hNk
  have hcard : Nat.card (Submodule.torsionBy ℤ (E.Point t) (N : ℤ)) = N ^ 2 := by
    rw [Nat.card_congr e.toEquiv]
    simp [Nat.card_pi, Nat.card_zmod]
  have hmemQ : ∀ n : ZMod N, ((n.val : ℤ) • Q₀) ∈
      Submodule.torsionBy ℤ (E.Point t) (N : ℤ) := by
    intro n
    refine (Submodule.mem_torsionBy_iff _ _).mpr ?_
    rw [smul_comm, hQ₀, smul_zero]
  have hsurj : Function.Surjective (fun n : ZMod N =>
      (⟨(n.val : ℤ) • Q₀, hmemQ n⟩ :
        Submodule.torsionBy ℤ (E.Point t) (N : ℤ))) := by
    intro x
    obtain ⟨n, hn⟩ := hgen x.1 ((Submodule.mem_torsionBy_iff _ _).mp x.2)
    refine ⟨(n : ZMod N), Subtype.ext ?_⟩
    show (((n : ZMod N).val : ℤ)) • Q₀ = (x : E.Point t)
    obtain ⟨c, hc⟩ : (N : ℤ) ∣ (((n : ZMod N).val : ℤ) - n) := by
      rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast
      rw [ZMod.natCast_val, ZMod.cast_id]
      ring
    have hdiff : (((n : ZMod N).val : ℤ)) • Q₀ - n • Q₀ = 0 := by
      rw [← sub_smul, hc, mul_smul, smul_comm, hQ₀, smul_zero]
    rw [sub_eq_zero] at hdiff
    rw [hdiff, hn]
  have hle := Nat.card_le_card_of_surjective _ hsurj
  rw [hcard, Nat.card_zmod] at hle
  nlinarith [hle]

set_option backward.isDefEq.respectTransparency false in
set_option maxHeartbeats 1600000 in
/-- **([hArb-2c], `P`-side)** The first marked section of a naive full level-`N`
structure (`N > 1`) is fibrewise nonzero. -/
theorem pull_ne_zero_left_of_isNaiveFullLevel (N : ℕ) [NeZero N] (hN1 : 1 < N)
    (hN : NIsInvertible S N) {P Q : E.Section} (hL : E.IsNaiveFullLevel N P Q)
    (k : Type u) [Field k] [IsAlgClosed k] (t : Spec (CommRingCat.of k) ⟶ S) :
    t ≫ (P : S ⟶ E.E) ≠ t ≫ E.zero := by
  intro hc
  obtain ⟨⟨hPk, hQk⟩, hgen⟩ := hL
  have hP0 : Point.pull E t P = 0 :=
    Subtype.ext (hc.trans (E.point_zero_val t).symm)
  have hNk : (N : k) ≠ 0 := (nIsInvertible_spec_iff k N).mp (hN.of_hom t)
  have hQNkill : (N : ℤ) • Point.pull E t Q = 0 := by
    rw [← Point.pull_zsmul, hQk, Point.pull_zero]
  have hgen' : ∀ x : E.Point t, (N : ℤ) • x = 0 →
      ∃ n : ℤ, n • Point.pull E t Q = x := by
    intro x hx
    have hmem := hgen k t x hx
    rw [AddSubgroup.mem_closure_pair] at hmem
    obtain ⟨m, n, hmn⟩ := hmem
    exact ⟨n, by rw [← hmn, hP0, smul_zero, zero_add]⟩
  have := E.le_one_of_torsion_generated_by_single N hNk
    (Point.pull E t Q) hQNkill hgen'
  omega

set_option backward.isDefEq.respectTransparency false in
set_option maxHeartbeats 1600000 in
/-- **([hArb-2c], `Q`-side)** The second marked section of a naive full level-`N`
structure (`N > 1`) is fibrewise nonzero. -/
theorem pull_ne_zero_right_of_isNaiveFullLevel (N : ℕ) [NeZero N] (hN1 : 1 < N)
    (hN : NIsInvertible S N) {P Q : E.Section} (hL : E.IsNaiveFullLevel N P Q)
    (k : Type u) [Field k] [IsAlgClosed k] (t : Spec (CommRingCat.of k) ⟶ S) :
    t ≫ (Q : S ⟶ E.E) ≠ t ≫ E.zero := by
  intro hc
  obtain ⟨⟨hPk, hQk⟩, hgen⟩ := hL
  have hQ0 : Point.pull E t Q = 0 :=
    Subtype.ext (hc.trans (E.point_zero_val t).symm)
  have hNk : (N : k) ≠ 0 := (nIsInvertible_spec_iff k N).mp (hN.of_hom t)
  have hPNkill : (N : ℤ) • Point.pull E t P = 0 := by
    rw [← Point.pull_zsmul, hPk, Point.pull_zero]
  have hgen' : ∀ x : E.Point t, (N : ℤ) • x = 0 →
      ∃ n : ℤ, n • Point.pull E t P = x := by
    intro x hx
    have hmem := hgen k t x hx
    rw [AddSubgroup.mem_closure_pair] at hmem
    obtain ⟨m, n, hmn⟩ := hmem
    exact ⟨m, by rw [← hmn, hQ0, smul_zero, add_zero]⟩
  have := E.le_one_of_torsion_generated_by_single N hNk
    (Point.pull E t P) hPNkill hgen'
  omega

set_option backward.isDefEq.respectTransparency false in
set_option maxHeartbeats 1600000 in
/-- **([O2b] the `±`-independence)** The second marked point of a naive full level-`N`
structure (`N > 1`) differs from `±`(the first) at every geometric point: otherwise the
pair is singly generated and `N² ≤ N`. -/
theorem pull_ne_pm_of_isNaiveFullLevel (N : ℕ) [NeZero N] (hN1 : 1 < N)
    (hN : NIsInvertible S N) {P Q : E.Section} (hL : E.IsNaiveFullLevel N P Q)
    (k : Type u) [Field k] [IsAlgClosed k] (t : Spec (CommRingCat.of k) ⟶ S) :
    Point.pull E t Q ≠ Point.pull E t P ∧ Point.pull E t Q ≠ -Point.pull E t P := by
  obtain ⟨⟨hPk, hQk⟩, hgen⟩ := hL
  have hNk : (N : k) ≠ 0 := (nIsInvertible_spec_iff k N).mp (hN.of_hom t)
  have hPN : (N : ℤ) • Point.pull E t P = 0 := by
    rw [← Point.pull_zsmul, hPk, Point.pull_zero]
  constructor
  · intro hc
    have hgen' : ∀ x : E.Point t, (N : ℤ) • x = 0 →
        ∃ n : ℤ, n • Point.pull E t P = x := by
      intro x hx
      obtain ⟨m, n, hmn⟩ := AddSubgroup.mem_closure_pair.mp (hgen k t x hx)
      refine ⟨m + n, ?_⟩
      rw [← hmn, hc, add_smul]
    have := E.le_one_of_torsion_generated_by_single N hNk
      (Point.pull E t P) hPN hgen'
    omega
  · intro hc
    have hgen' : ∀ x : E.Point t, (N : ℤ) • x = 0 →
        ∃ n : ℤ, n • Point.pull E t P = x := by
      intro x hx
      obtain ⟨m, n, hmn⟩ := AddSubgroup.mem_closure_pair.mp (hgen k t x hx)
      refine ⟨m - n, ?_⟩
      rw [← hmn, hc, sub_smul, smul_neg]
      abel
    have := E.le_one_of_torsion_generated_by_single N hNk
      (Point.pull E t P) hPN hgen'
    omega


end EllipticCurve

end ModularCurves
