
  -- 6e′ (germ-free): the localization at the augmentation prime
  set L := CommRingCat.of (Localization.AtPrime (RingHom.ker (foldε ε').toRingHom)) with hLdef
  set algL : CommRingCat.of (↑Γ(F.E, U) ⊗[↑Γ(Spec (CommRingCat.of k), ⊤)] ↑Γ(F.E, U)) ⟶ L :=
    CommRingCat.ofHom
      (algebraMap _ (Localization.AtPrime (RingHom.ker (foldε ε').toRingHom))) with halgL
  set Lε := CommRingCat.of (Localization.AtPrime (RingHom.ker ε'.toRingHom)) with hLεdef
  set algLε : Γ(F.E, U) ⟶ Lε := CommRingCat.ofHom
    (algebraMap ↑Γ(F.E, U) (Localization.AtPrime (RingHom.ker ε'.toRingHom))) with halgLε
  set φL : ↑L →+* ↑R := IsLocalization.lift
    (M := (RingHom.ker (foldε ε').toRingHom).primeCompl) (g := pT.toRingHom) hunits with hφLdef
  have hφLalg : ∀ y, φL (algL.hom y) = pT y := fun y => IsLocalization.lift_eq hunits y
  -- the localized box point lands in the chart (generization stability)
  have hrangeL : ∀ x : ↑(Spec L), (Spec.map algL ≫ q).base x ∈ U := by
    intro x
    have hle : ((Spec.map algL).base x).asIdeal ≤ p𝔭.asIdeal := by
      intro a ha
      by_contra hnot
      have hu : IsUnit (algL.hom a) := IsLocalization.map_units
        (M := (RingHom.ker (foldε ε').toRingHom).primeCompl) _ ⟨a, hnot⟩
      exact x.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ ha hu)
    have hspec : ((Spec.map algL).base x) ⤳ p𝔭 := PrimeSpectrum.le_iff_specializes.mp hle
    have hspec2 : (q.base ((Spec.map algL).base x)) ⤳ (q.base p𝔭) := hspec.map q.continuous
    exact hspec2.mem_open U.2 hqp
  set ψ' := pointSharp (Spec.map algL ≫ q) hrangeL with hψ'
  -- 6f. the sum's chart evaluation factors through the localization
  have hfacSpec : Spec.map (CommRingCat.ofHom pT.toRingHom) =
      Spec.map (CommRingCat.ofHom φL) ≫ Spec.map algL := by
    rw [← Spec.map_comp]
    refine congrArg Spec.map ?_
    refine CommRingCat.hom_ext (RingHom.ext fun y => ?_)
    exact (hφLalg y).symm
  have hkey : pointSharp ((P₁ + P₂ : F.Point t) : Spec R ⟶ F.E) hp₁₂ =
      ψ' ≫ CommRingCat.ofHom φL := by
    have hcomp2 : ∀ x : ↑(Spec R),
        (Spec.map (CommRingCat.ofHom φL) ≫ Spec.map algL ≫ q).base x ∈ U := by
      intro x
      have h0 : (Spec.map (CommRingCat.ofHom φL) ≫ Spec.map algL ≫ q).base x =
          (Spec.map algL ≫ q).base ((Spec.map (CommRingCat.ofHom φL)).base x) := rfl
      rw [h0]
      exact hrangeL _
    rw [pointSharp_congr (show ((P₁ + P₂ : F.Point t) : Spec R ⟶ F.E) =
        Spec.map (CommRingCat.ofHom φL) ≫ Spec.map algL ≫ q by
      rw [hsum, hfacSpec, Category.assoc]) hp₁₂ hcomp2]
    exact pointSharp_specMap_comp (CommRingCat.ofHom φL) hrangeL hcomp2
  -- 6g. the axis moves kill the augmentation defect
  have hcompatL : (RingHom.ker (foldε ε').toRingHom).primeCompl ≤
      Submonoid.comap (axisL ε').toRingHom (RingHom.ker ε'.toRingHom).primeCompl := by
    intro y hy h0
    exact hy (by
      simp only [RingHom.mem_ker] at h0 ⊢
      rw [show (foldε ε').toRingHom y = ε' ((axisL ε') y) from foldε_eq_axisL ε' y, h0,
        map_zero])
  have hcompatR : (RingHom.ker (foldε ε').toRingHom).primeCompl ≤
      Submonoid.comap (axisR ε').toRingHom (RingHom.ker ε'.toRingHom).primeCompl := by
    intro y hy h0
    exact hy (by
      simp only [RingHom.mem_ker] at h0 ⊢
      rw [show (foldε ε').toRingHom y = ε' ((axisR ε') y) from foldε_eq_axisR ε' y, h0,
        map_zero])
  set āL : ↑L →+* ↑Lε := IsLocalization.map
    (M := (RingHom.ker (foldε ε').toRingHom).primeCompl)
    (T := (RingHom.ker ε'.toRingHom).primeCompl) _ (axisL ε').toRingHom hcompatL with hāL
  set āR : ↑L →+* ↑Lε := IsLocalization.map
    (M := (RingHom.ker (foldε ε').toRingHom).primeCompl)
    (T := (RingHom.ker ε'.toRingHom).primeCompl) _ (axisR ε').toRingHom hcompatR with hāR
  have hāLalg : ∀ y, āL (algL.hom y) = algLε.hom ((axisL ε') y) :=
    fun y => IsLocalization.map_eq (S := ↑L) hcompatL y
  have hāRalg : ∀ y, āR (algL.hom y) = algLε.hom ((axisR ε') y) :=
    fun y => IsLocalization.map_eq (S := ↑L) hcompatR y
  -- the axis evaluation of ψ' (the localized unit laws)
  have haxψ : ∀ (ā : ↑L →+* ↑Lε)
      (axSpec : Spec.map (CommRingCat.ofHom ā) ≫ Spec.map algL ≫ q =
        Spec.map algLε ≫ hU.fromSpec),
      ψ' ≫ CommRingCat.ofHom ā = algLε := by
    intro ā axSpec
    have hcomp3 : ∀ x : ↑(Spec Lε),
        (Spec.map (CommRingCat.ofHom ā) ≫ Spec.map algL ≫ q).base x ∈ U := by
      intro x
      have h0 : (Spec.map (CommRingCat.ofHom ā) ≫ Spec.map algL ≫ q).base x =
          (Spec.map algL ≫ q).base ((Spec.map (CommRingCat.ofHom ā)).base x) := rfl
      rw [h0]
      exact hrangeL _
    have h1 := pointSharp_specMap_comp (CommRingCat.ofHom ā) hrangeL hcomp3
    have hcomp4 : ∀ x : ↑(Spec Lε), (Spec.map algLε ≫ hU.fromSpec).base x ∈ U := by
      intro x
      have h0 : (Spec.map algLε ≫ hU.fromSpec).base x =
          (hU.fromSpec).base ((Spec.map algLε).base x) := rfl
      rw [h0]
      exact htautU _
    have h2 : pointSharp (Spec.map (CommRingCat.ofHom ā) ≫ Spec.map algL ≫ q) hcomp3 =
        pointSharp (Spec.map algLε ≫ hU.fromSpec) hcomp4 :=
      pointSharp_congr axSpec hcomp3 hcomp4
    have h3 := pointSharp_specMap_comp algLε htautU hcomp4
    rw [h1.symm.trans (h2.trans h3), pointSharp_fromSpec hU htautU, Category.id_comp]
  -- the two axis Spec-squares
  have haxSpecL : Spec.map (CommRingCat.ofHom āL) ≫ Spec.map algL ≫ q =
      Spec.map algLε ≫ hU.fromSpec := by
    have hsq : algL ≫ CommRingCat.ofHom āL =
        CommRingCat.ofHom (axisL ε').toRingHom ≫ algLε := by
      refine CommRingCat.hom_ext (RingHom.ext fun y => ?_)
      exact hāLalg y
    rw [← Category.assoc, ← Spec.map_comp, ← hsq, Spec.map_comp, Category.assoc]
    congr 1
    exact haxLq
  have haxSpecR : Spec.map (CommRingCat.ofHom āR) ≫ Spec.map algL ≫ q =
      Spec.map algLε ≫ hU.fromSpec := by
    have hsq : algL ≫ CommRingCat.ofHom āR =
        CommRingCat.ofHom (axisR ε').toRingHom ≫ algLε := by
      refine CommRingCat.hom_ext (RingHom.ext fun y => ?_)
      exact hāRalg y
    rw [← Category.assoc, ← Spec.map_comp, ← hsq, Spec.map_comp, Category.assoc]
    congr 1
    exact haxRq
  have haxL := congrArg (fun (m : Γ(F.E, U) ⟶ Lε) => m.hom f) (haxψ āL haxSpecL)
  have haxR := congrArg (fun (m : Γ(F.E, U) ⟶ Lε) => m.hom f) (haxψ āR haxSpecR)
  -- the defect and its kill
  set a : ↑L := ψ'.hom f - algL.hom (f ⊗ₜ 1) - algL.hom (1 ⊗ₜ f) with hadef
  have hāLa : āL a = 0 := by
    rw [hadef, map_sub, map_sub, hāLalg, hāLalg, haxL]
    rw [show (axisL ε') (f ⊗ₜ 1) = algebraMap _ _ (ε' f) * 1 from axisL_tmul ε' f 1,
      show (axisL ε') (1 ⊗ₜ f) = algebraMap _ _ (ε' (1 : ↑Γ(F.E, U))) * f from
        axisL_tmul ε' 1 f, hεf, map_zero, map_one, _root_.zero_mul, _root_.one_mul,
      map_zero]
    ring
  have hāRa : āR a = 0 := by
    rw [hadef, map_sub, map_sub, hāRalg, hāRalg, haxR]
    rw [show (axisR ε') (f ⊗ₜ 1) = f * algebraMap _ _ (ε' (1 : ↑Γ(F.E, U))) from
        axisR_tmul ε' f 1,
      show (axisR ε') (1 ⊗ₜ f) = 1 * algebraMap _ _ (ε' f) from axisR_tmul ε' 1 f,
      hεf, map_zero, map_one, _root_.mul_zero, _root_.mul_one, map_zero]
    ring
  obtain ⟨⟨y, sden⟩, hys⟩ := IsLocalization.surj
    (M := (RingHom.ker (foldε ε').toRingHom).primeCompl) a
  have hyL0 : algLε.hom ((axisL ε') y) = 0 := by
    have h1 := congrArg āL hys
    rw [map_mul, hāLa, _root_.zero_mul, hāLalg] at h1
    exact h1.symm
  have hyR0 : algLε.hom ((axisR ε') y) = 0 := by
    have h1 := congrArg āR hys
    rw [map_mul, hāRa, _root_.zero_mul, hāRalg] at h1
    exact h1.symm
  obtain ⟨u, hu⟩ := (IsLocalization.map_eq_zero_iff
    (RingHom.ker ε'.toRingHom).primeCompl _ _).mp hyL0
  obtain ⟨v, hv⟩ := (IsLocalization.map_eq_zero_iff
    (RingHom.ker ε'.toRingHom).primeCompl _ _).mp hyR0
  set y' := ((1 : ↑Γ(F.E, U)) ⊗ₜ[↑Γ(Spec (CommRingCat.of k), ⊤)] (u : ↑Γ(F.E, U))) *
    ((((v : ↑Γ(F.E, U)) ⊗ₜ[↑Γ(Spec (CommRingCat.of k), ⊤)] (1 : ↑Γ(F.E, U)))) * y) with hy'
  have haxLy' : (axisL ε') y' = 0 := by
    rw [hy', map_mul, map_mul, axisL_tmul, axisL_tmul, map_one, _root_.one_mul,
      _root_.mul_one]
    calc (u : ↑Γ(F.E, U)) * (algebraMap _ _ (ε' (v : ↑Γ(F.E, U))) * (axisL ε') y)
        = algebraMap _ _ (ε' (v : ↑Γ(F.E, U))) * ((u : ↑Γ(F.E, U)) * (axisL ε') y) := by
          ring
      _ = 0 := by rw [hu, _root_.mul_zero]
  have haxRy' : (axisR ε') y' = 0 := by
    rw [hy', map_mul, map_mul, axisR_tmul, axisR_tmul, map_one, _root_.mul_one,
      _root_.one_mul]
    calc algebraMap _ _ (ε' (u : ↑Γ(F.E, U))) * ((v : ↑Γ(F.E, U)) * (axisR ε') y)
        = algebraMap _ _ (ε' (u : ↑Γ(F.E, U))) * ((v : ↑Γ(F.E, U)) * (axisR ε') y) := rfl
      _ = 0 := by rw [hv, _root_.mul_zero]
  have hpTy' : pT y' = 0 := by
    rw [hpTdef]
    exact pairLift_eq_zero_of_axes ε' p₁ p₂ hcl₁ hcl₂ hII haxLy' haxRy'
  have hpTy : pT y = φL a * pT sden := by
    have h1 := congrArg φL hys
    rw [map_mul, hφLalg, hφLalg] at h1
    exact h1.symm
  have hunit_u : IsUnit (pT ((1 : ↑Γ(F.E, U)) ⊗ₜ (u : ↑Γ(F.E, U)))) := by
    refine hunits ⟨_, fun h0 => u.2 ?_⟩
    simp only [RingHom.mem_ker] at h0 ⊢
    have h1 := (foldε_tmul ε' (1 : ↑Γ(F.E, U)) (u : ↑Γ(F.E, U))).symm.trans h0
    rwa [map_one, _root_.one_mul] at h1
  have hunit_v : IsUnit (pT ((v : ↑Γ(F.E, U)) ⊗ₜ (1 : ↑Γ(F.E, U)))) := by
    refine hunits ⟨_, fun h0 => v.2 ?_⟩
    simp only [RingHom.mem_ker] at h0 ⊢
    have h1 := (foldε_tmul ε' (v : ↑Γ(F.E, U)) (1 : ↑Γ(F.E, U))).symm.trans h0
    rwa [map_one, _root_.mul_one] at h1
  have hφLa : φL a = 0 := by
    have h0 : pT ((1 : ↑Γ(F.E, U)) ⊗ₜ (u : ↑Γ(F.E, U))) *
        (pT ((v : ↑Γ(F.E, U)) ⊗ₜ (1 : ↑Γ(F.E, U))) * (φL a * pT sden)) = 0 := by
      rw [← hpTy, ← map_mul, ← map_mul, ← hy']
      exact hpTy'
    have h1 := (hunit_u.mul_right_eq_zero).mp h0
    have h2 := (hunit_v.mul_right_eq_zero).mp h1
    have h3 : φL a * pT sden = 0 := h2
    have h4 := congrArg (· * ((hunits sden).unit⁻¹ : Units ↑R)) h3
    simpa [mul_assoc, IsUnit.mul_val_inv] using
      (hunits sden).mul_left_eq_zero.mp (by
        rw [_root_.mul_comm]
        exact h3)
  have hψ'f : φL (ψ'.hom f) = pT (f ⊗ₜ 1) + pT (1 ⊗ₜ f) := by
    have h1 : φL a = φL (ψ'.hom f) - pT (f ⊗ₜ 1) - pT (1 ⊗ₜ f) := by
      rw [hadef, map_sub, map_sub, hφLalg, hφLalg]
    rw [hφLa] at h1
    linarith [h1]
  have hfinal := congrArg (fun (m : Γ(F.E, U) ⟶ R) => m.hom f) hkey
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hfinal
  show (pointSharp ((P₁ + P₂ : F.Point t) : Spec R ⟶ F.E) hp₁₂).hom f = _
  rw [hfinal, hψ'f]
  have hpT1 : pT (f ⊗ₜ 1) = (pointSharp P₁.1 hp₁).hom f := by
    have h2 := congrArg (fun (m : _ ⟶ R) => m.hom f) hidL
    simpa using h2
  have hpT2 : pT (1 ⊗ₜ f) = (pointSharp P₂.1 hp₂).hom f := by
    have h2 := congrArg (fun (m : _ ⟶ R) => m.hom f) hidR
    simpa using h2
  rw [hpT1, hpT2]
